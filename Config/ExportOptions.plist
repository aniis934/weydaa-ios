<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Options d'export de l'archive (xcodebuild -exportArchive), utilisées par scripts/ci/release.sh :
    méthode App Store Connect, envoi DIRECT à App Store Connect (TestFlight), signature automatique
    « dans le nuage » (clé API App Store Connect). teamID n'est pas ici : release.sh l'ajoute à une
    copie temporaire depuis le secret APPLE_TEAM_ID. Numéro de build géré par la CI, pas par Xcode.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>testFlightInternalTestingOnly</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
