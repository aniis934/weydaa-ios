<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Clés qu'Xcode ne sait pas générer seul (GENERATE_INFOPLIST_FILE complète le reste depuis
    project.yml : nom affiché, version, orientation, scènes).
    NSCameraUsageDescription : appareil photo de l'assistant de dépôt, texte traduit dans *.lproj/InfoPlist.strings.
    Pas de clé photothèque : la galerie (PhotosPicker) tourne hors de l'app et n'en demande pas.
    Push (phase 5) : UIBackgroundModes remote-notification (messages FCM) ; FirebaseAppDelegateProxyEnabled NO = pas de
    swizzling, le jeton APNs et les notifications passent à la main (AppDelegate, Core/Push).
-->
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>ar</string>
		<string>en</string>
	</array>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Weydaa utilise l'appareil photo pour photographier les objets de vos annonces.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>SplashMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>WeydaAPIHost</key>
	<string>$(WEYDA_API_HOST)</string>
	<key>WeydaSupabaseHost</key>
	<string>$(WEYDA_SUPABASE_HOST)</string>
	<key>WeydaSupabaseAnonKey</key>
	<string>$(WEYDA_SUPABASE_ANON_KEY)</string>
	<key>WeydaGoogleIOSClientID</key>
	<string>$(WEYDA_GOOGLE_IOS_CLIENT_ID)</string>
</dict>
</plist>
